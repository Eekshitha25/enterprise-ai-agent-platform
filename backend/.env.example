# --- FREE / LOCAL SETUP (default, no API keys or payment needed) ---
MODEL_PROVIDER=ollama              # ollama (free/local) | anthropic | openai
CHAT_MODEL=llama3.1                # any model you've pulled with `ollama pull <model>`
OLLAMA_BASE_URL=http://host.docker.internal:11434

EMBEDDING_PROVIDER=local           # local (free, sentence-transformers) | openai
EMBEDDING_MODEL=text-embedding-3-large

# --- PAID SETUP (only needed if you switch MODEL_PROVIDER/EMBEDDING_PROVIDER above) ---
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_admin
POSTGRES_PASSWORD=change_me

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_knowledge

# AWS (for the real cost-explorer tool; mocked by default)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
USE_MOCK_AWS_TOOL=true

APP_ENV=development
LOG_LEVEL=INFO
